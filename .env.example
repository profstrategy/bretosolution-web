# Public site configuration
NEXT_PUBLIC_SITE_URL=

# PostgreSQL (pooled runtime URL and direct migration URL)
DATABASE_URL=
DIRECT_URL=

# Request API security and notifications
RATE_LIMIT_SALT=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_FROM_EMAIL=

# Admin authentication (see docs/ADMIN_AUTH.md)
NEXTAUTH_URL=
NEXTAUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH_B64=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin email dashboard (see scripts/smoke-admin-api.md)
# Public support address shown in the admin and used as reply-to.
ADMIN_INBOX_ADDRESS=
# Supabase Storage for PDF attachments (server only). SUPABASE_URL falls back
# to NEXT_PUBLIC_SUPABASE_URL. Never expose the service role key to the client.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
