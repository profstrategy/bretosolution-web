// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

enum RequestStatus {
  NEW
  CONTACTED
  CLOSED
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AuditRequest {
  id                 String        @id @default(cuid())
  businessName       String
  websiteOrInstagram String
  city               String
  /// Null for requests made before the field existed (2026-11-27).
  fullAddress        String?
  businessType       String
  email              String
  status             RequestStatus @default(NEW)
  createdAt          DateTime      @default(now())
  ipHash             String
  userAgent          String?
  notifiedAt         DateTime?
  consentAcceptedAt  DateTime?
  consentVersion     String?
}

model QuoteRequest {
  id                 String        @id @default(cuid())
  businessType       String
  helpNeeded         String
  mainChallenge      String?
  contactName        String
  businessName       String
  email              String
  phoneOrWhatsapp    String?
  websiteOrInstagram String?
  countryRegion      String
  /// Null for requests made before the field existed (2026-11-27).
  fullAddress        String?
  status             RequestStatus @default(NEW)
  createdAt          DateTime      @default(now())
  ipHash             String
  userAgent          String?
  notifiedAt         DateTime?
  consentAcceptedAt  DateTime?
  consentVersion     String?
}

model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String
  ipHash    String
  createdAt DateTime @default(now())

  @@index([bucket, ipHash, createdAt])
  @@index([createdAt])
}

enum AdminEmailKind {
  AUDIT
  QUOTE
  GENERAL
}

enum AdminEmailStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

/// Which website submission an admin email answers (AuditRequest or QuoteRequest).
enum AdminEmailSourceType {
  AUDIT
  QUOTE
}

model AdminEmail {
  id                 String                @id @default(cuid())
  kind               AdminEmailKind
  status             AdminEmailStatus      @default(DRAFT)
  toEmail            String
  recipientName      String?
  businessName       String?
  subject            String
  bodyHtml           String
  calendlyUrl        String?
  rows               Json?
  attachmentPath     String?
  attachmentName     String?
  attachmentSize     Int?
  inReplyToMessageId String?
  /// Set only when the email answers a website request; verified at render time.
  sourceRequestType  AdminEmailSourceType?
  sourceRequestId    String?
  resendId           String?               @unique
  lastEvent          String?
  error              String?
  sentAt             DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([status, createdAt])
}
