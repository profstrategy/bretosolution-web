# Every variable is read at request time; `npm run build` needs none of them.
# Never commit real values. Admin details: docs/ADMIN.md.

# Public site configuration
NEXT_PUBLIC_SITE_URL=

# PostgreSQL (pooled runtime URL, port 6543 with ?pgbouncer=true; direct URL for migrations)
DATABASE_URL=
DIRECT_URL=

# Request API security and notifications
RATE_LIMIT_SALT=
# Resend key with full access (the admin reads delivery status and received mail).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Verified sender, also used for admin emails, e.g. "Bretosolution <hello@bretosolution.com>".
LEAD_FROM_EMAIL=

# Admin authentication (see docs/ADMIN_AUTH.md)
# The exact public origin (https://bretosolution.com, no trailing slash). Admin API
# changes are accepted only from this origin.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
ADMIN_EMAIL=
# Output of `npm run admin:hash`.
ADMIN_PASSWORD_HASH_B64=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin email dashboard (see docs/ADMIN.md)
# Public support address: received mail to it is listed, and it is the reply-to.
# Defaults to hello@bretosolution.com.
ADMIN_INBOX_ADDRESS=
# Supabase Storage for PDF attachments (server only; private bucket
# "admin-email-attachments", 15 MB, application/pdf). SUPABASE_URL falls back
# to NEXT_PUBLIC_SUPABASE_URL. Never expose the service role key to the client.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
